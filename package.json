{
  "name": "dsh-context-kit",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Native DeepSeek Harness integrations for DCP, Context Mode, and History Editor.",
  "exports": {
    ".": "./lib/index.js",
    "./dcp": "./lib/dcp.js",
    "./context-mode": "./lib/context-mode.js",
    "./dcp-plugin": "./lib/dcp-plugin.js",
    "./dcp-plugin/package.json": "./package.json",
    "./dcp-plugin/locale/*.json": "./locale/dcp-plugin/*.json",
    "./context-mode-plugin": "./lib/context-mode-plugin.js",
    "./context-mode-plugin/package.json": "./package.json",
    "./context-mode-plugin/locale/*.json": "./locale/context-mode-plugin/*.json",
    "./editor-plugin": "./lib/editor-plugin.js",
    "./editor-plugin/package.json": "./package.json",
    "./editor-plugin/locale/*.json": "./locale/editor-plugin/*.json",
    "./plugin": "./lib/plugin.js",
    "./plugin/package.json": "./package.json",
    "./plugin/locale/*.json": "./locale/plugin/*.json",
    "./client": "./lib/edit-client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-plugins"]
    }
  },
  "files": [
    "lib",
    "locale/*.json",
    "locale/**/*.json",
    "runtime",
    "runtime-2",
    "cordis.patch.yml"
  ]
}
