{
  "name": "cdsh",
  "version": "0.3.0",
  "description": "Custom DSH regional theming with 38 themes and optional workspace enhancements.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "test",
    "vendor",
    "legal",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/check-publication.mjs",
    "test": "node --test test/enhancements.test.mjs test/faithful-layout.test.mjs test/panel.test.mjs test/runtime.test.mjs test/studio.test.mjs test/tool-motion.test.mjs test/workspace-model.test.mjs",
    "test:builder": "node scripts/build.mjs --selftest",
    "test:native": "node scripts/check-native-contracts.mjs",
    "verify": "node scripts/check-publication.mjs",
    "prepack": "npm run check && npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "regional",
    "cdsh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT"
}
